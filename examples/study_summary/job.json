{
  "schema_version": 1,
  "job_id": "study-summary",
  "title": "Check a study summary against a selected practice log",
  "intent": "Correct the copied observation while retaining the approved title and practice plan; do not certify the causal claim.",
  "contract_version": "contract-1",
  "artifact": {
    "path": "study-summary.docx",
    "version": "draft-1",
    "kind": "docx_report"
  },
  "sources": [
    {
      "id": "study-log",
      "path": "study-log.txt",
      "version": "source-1"
    }
  ],
  "requirements": [
    {
      "id": "quoted-duration",
      "kind": "docx.quote",
      "description": "The copied observation must exactly match the selected source line.",
      "mode": "must_change",
      "config": {
        "paragraph_index": 3,
        "source_id": "study-log",
        "source_line": 2,
        "prefix": "Source note: "
      }
    },
    {
      "id": "preserve-title",
      "kind": "docx.preserve_paragraph",
      "description": "Keep the approved report title unchanged.",
      "mode": "must_preserve",
      "config": {
        "paragraph_index": 1,
        "expected": "Study Practice Summary"
      }
    },
    {
      "id": "preserve-plan",
      "kind": "docx.preserve_paragraph",
      "description": "Keep the approved weekly practice plan unchanged.",
      "mode": "must_preserve",
      "config": {
        "paragraph_index": 4,
        "expected": "Planned weekly practice remains 3 sessions."
      }
    },
    {
      "id": "causal-effect",
      "kind": "semantic.causal_claim",
      "description": "Does this method guarantee better exam results?",
      "mode": "unknown",
      "config": {
        "paragraph_index": 5
      }
    }
  ]
}
