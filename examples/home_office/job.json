    {
      "id": "preserve-option",
      "kind": "xlsx.preserve_cell",
      "description": "Keep the unrelated existing monitor option",
      "mode": "must_preserve",
      "config": {
        "sheet": "Budget",
        "cell": "B12",
        "expected": "Keep existing monitor"
      }
    },
    {
      "id": "ergonomics",
      "kind": "semantic.claim",
      "description": "The chosen chair will be comfortable for this user",
      "mode": "unknown",
