      "config": {
        "sheet": "Budget",
        "cell": "B5",
        "source_id": "prices",
        "source_key": "chair",
        "currency": "USD"
      }
    },
    {
      "id": "delivery",
      "kind": "xlsx.source_amount",
      "description": "Include required delivery cost",
      "mode": "must_change",
      "config": {
        "sheet": "Budget",
        "cell": "B6",
        "source_id": "prices",
        "source_key": "delivery",
        "currency": "USD"
      }
    },
    {
